---
import "../styles/global.css";
import regalo from "../content/regalo.json";
import Icono from "../components/Icono.astro";

// Secuencia de mensajes: los de la lista y, al final, la firma.
const datos = { mensajes: [...regalo.mensajes, regalo.firma], siguiente: regalo.boton_siguiente, ayuda: regalo.boton_ayuda };
const { ayuda } = regalo;
---
<!doctype html>
<html lang="es-AR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{regalo.titulo}</title>
  <meta name="robots" content="noindex, nofollow">
  <meta name="theme-color" content="#FBF4EA">
  <link rel="icon" href="/img/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,300..600,100,1;1,9..144,300..600,100,1&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class="regalo-body">

<svg width="0" height="0" aria-hidden="true" focusable="false">
  <clipPath id="flor" clipPathUnits="objectBoundingBox">
    <circle cx=".27" cy=".27" r=".27"/><circle cx=".73" cy=".27" r=".27"/>
    <circle cx=".27" cy=".73" r=".27"/><circle cx=".73" cy=".73" r=".27"/>
    <rect x=".25" y=".25" width=".5" height=".5"/>
  </clipPath>
</svg>

<div class="escena" data-etapa="cerrado">
  <span class="fl f1" aria-hidden="true"></span><span class="fl f2" aria-hidden="true"></span><span class="fl f3" aria-hidden="true"></span>
  <div class="chispas" aria-hidden="true"></div>

  <div class="juego">
    <p class="texto" aria-live="polite">{regalo.pista}</p>

    <button class="caja" type="button" aria-label={regalo.pista}>
      <svg viewBox="0 0 200 200" aria-hidden="true">
        <ellipse cx="100" cy="188" rx="72" ry="8" fill="#4A2530" opacity=".14"/>
        <rect x="30" y="96" width="140" height="86" rx="8" fill="#E79FA0"/>
        <rect x="92" y="96" width="16" height="86" fill="#FBF4EA"/>
        <path d="M58 150c-8-8-3-17 4-15 3 1 4 3 4 3s1-2 4-3c7-2 12 7 4 15l-8 8z" fill="#FBF4EA" opacity=".9"/>
        <ellipse cx="100" cy="97" rx="68" ry="9" fill="#C97F84"/>
        <ellipse class="luz" cx="100" cy="88" rx="58" ry="34" fill="#FFF8E7"/>
        <g class="tapa">
          <rect x="22" y="70" width="156" height="32" rx="8" fill="#C9B0BA"/>
          <rect x="92" y="70" width="16" height="32" fill="#FBF4EA"/>
        </g>
        <g class="mono">
          <ellipse cx="78" cy="58" rx="24" ry="13" transform="rotate(-28 78 58)" fill="#FBF4EA" stroke="#E8E0C0" stroke-width="2"/>
          <ellipse cx="122" cy="58" rx="24" ry="13" transform="rotate(28 122 58)" fill="#FBF4EA" stroke="#E8E0C0" stroke-width="2"/>
          <circle cx="100" cy="66" r="10" fill="#F0C3C0"/>
        </g>
      </svg>
    </button>

    <button class="btn siguiente" type="button" hidden>{regalo.boton_siguiente}</button>
  </div>

  <div class="ayuda" hidden>
    <h1 tabindex="-1">{ayuda.titulo}</h1>
    <p class="bajada">{ayuda.bajada}</p>
    <ul class="beneficios">
      {ayuda.items.map((b, n) => (
        <li style={`--i:${n}`}><span class="ico"><Icono nombre={b.icono} /></span><div><h2>{b.titulo}</h2><p>{b.texto}</p></div></li>
      ))}
    </ul>
    <div class="cierre" style={`--i:${ayuda.items.length}`}>
      <h2>{ayuda.cierre_titulo}</h2>
      <p>{ayuda.cierre_texto}</p>
    </div>
    <button class="btn ver-pagina" type="button">{regalo.boton_final}</button>
  </div>

  <div class="presentacion" hidden>
    <h1 tabindex="-1">{regalo.presentacion_titulo}</h1>
    <p>{regalo.presentacion_texto}</p>
    <div class="marco">
      <div class="barra" aria-hidden="true"><i></i><i></i><i></i></div>
      <iframe title="Vista de la página web" data-src="/" loading="lazy"></iframe>
    </div>
    <a class="btn" href="/">{regalo.boton_entrar}</a>
  </div>

  <a class="ir-directo" href="/">{regalo.saltar}</a>
</div>

<script type="application/json" id="datos" set:html={JSON.stringify(datos)}></script>
<script>
  import { CONFETI } from "../lib/iconos";

  const datos = JSON.parse(document.getElementById("datos")!.textContent!);
  const escena = document.querySelector<HTMLElement>(".escena")!;
  const caja = escena.querySelector<HTMLButtonElement>(".caja")!;
  const texto = escena.querySelector<HTMLElement>(".texto")!;
  const siguiente = escena.querySelector<HTMLButtonElement>(".siguiente")!;
  const presentacion = escena.querySelector<HTMLElement>(".presentacion")!;
  const ayuda = escena.querySelector<HTMLElement>(".ayuda")!;
  const chispas = escena.querySelector<HTMLElement>(".chispas")!;
  const sinMovimiento = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let i = -1;

  function confeti() {
    if (sinMovimiento) return;
    const colores = ["#E79FA0", "#F0C3C0", "#C9B0BA", "#8CA7AC"];
    for (let n = 0; n < 30; n++) {
      const s = document.createElement("span");
      s.innerHTML = CONFETI[n % CONFETI.length](colores[n % colores.length]);
      s.style.cssText = `left:${Math.random() * 100}%;font-size:${14 + Math.random() * 22}px;animation-delay:${Math.random() * 0.8}s;animation-duration:${3 + Math.random() * 2.5}s`;
      chispas.append(s);
      setTimeout(() => s.remove(), 6500);
    }
  }

  function mostrar(mensaje: string, esFirma: boolean) {
    texto.classList.add("sale");
    setTimeout(() => {
      texto.textContent = mensaje;
      texto.classList.toggle("firma", esFirma);
      texto.classList.remove("sale");
    }, sinMovimiento ? 0 : 280);
  }

  function avanzar() {
    i++;
    if (i < datos.mensajes.length) {
      const ultimo = i === datos.mensajes.length - 1;
      mostrar(datos.mensajes[i], ultimo);
      siguiente.hidden = false;
      siguiente.textContent = ultimo ? datos.ayuda : datos.siguiente;
      siguiente.focus({ preventScroll: true });
    } else {
      irA("ayuda", ayuda);
    }
  }

  // Cambia de etapa (ayuda → final): muestra el bloque, lo enfoca y sube al inicio.
  function irA(etapa: string, bloque: HTMLElement) {
    escena.dataset.etapa = etapa;
    bloque.hidden = false;
    confeti();
    bloque.querySelector<HTMLElement>("h1")!.focus({ preventScroll: true });
    scrollTo({ top: 0, behavior: sinMovimiento ? "auto" : "smooth" });
  }

  function verPagina() {
    ayuda.hidden = true;
    const marco = presentacion.querySelector("iframe")!;
    marco.src = marco.dataset.src!;
    irA("final", presentacion);
  }

  caja.addEventListener("click", () => {
    if (escena.dataset.etapa !== "cerrado") return;
    escena.dataset.etapa = "abriendo";
    caja.setAttribute("aria-disabled", "true");
    confeti();
    setTimeout(() => { escena.dataset.etapa = "mensajes"; avanzar(); }, sinMovimiento ? 0 : 1100);
  });
  siguiente.addEventListener("click", avanzar);
  ayuda.querySelector(".ver-pagina")!.addEventListener("click", verPagina);
</script>

<style>
  .regalo-body { margin: 0; background: var(--durazno); overflow-x: hidden; }
  .escena { position: relative; min-height: 100dvh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 32px 20px 72px; background: radial-gradient(ellipse at 50% 30%, var(--crema) 0%, var(--durazno) 70%); overflow: hidden; text-align: center; }
  .juego { display: flex; flex-direction: column; align-items: center; gap: 12px; width: min(100%, 560px); position: relative; z-index: 2; }
  .escena[data-etapa="ayuda"] .juego, .escena[data-etapa="final"] .juego { display: none; }

  /* Pétalos de fondo */
  .fl { position: absolute; clip-path: url(#flor); opacity: .5; animation: deriva 14s ease-in-out infinite alternate; }
  .f1 { width: 280px; aspect-ratio: 1; background: var(--rosa-suave); left: -90px; top: 6%; }
  .f2 { width: 220px; aspect-ratio: 1; background: var(--malva); right: -70px; top: 38%; animation-delay: -5s; }
  .f3 { width: 320px; aspect-ratio: 1; background: #E3EBEC; left: 20%; bottom: -150px; animation-delay: -9s; }
  @keyframes deriva { to { transform: translate(24px, -28px) rotate(14deg); } }

  /* Texto de cada mensaje */
  .texto { min-height: 4.2em; display: grid; place-items: center; margin: 0 0 8px; font-family: var(--serif); font-variation-settings: "SOFT" 100, "WONK" 1; font-size: clamp(1.9rem, 7vw, 3.4rem); font-weight: 420; line-height: 1.12; letter-spacing: -.015em; color: var(--burdeos); text-wrap: balance; max-width: 18ch; transition: opacity .28s, transform .28s; }
  .texto.sale { opacity: 0; transform: translateY(10px); }
  .texto.firma { font-style: italic; color: var(--salvia-oscuro); }
  .escena[data-etapa="cerrado"] .texto { font-size: var(--t-l); font-family: var(--sans); font-weight: 500; font-variation-settings: normal; min-height: 2.4em; animation: pulso 2.4s ease-in-out infinite; }

  /* El regalo */
  .caja { background: none; border: 0; padding: 0; width: clamp(220px, 58vw, 320px); cursor: pointer; border-radius: 24px; animation: flotar 3.2s ease-in-out infinite; }
  .caja:hover { filter: brightness(1.04); }
  .caja svg { width: 100%; height: auto; overflow: visible; }
  .caja .tapa, .caja .mono { transform-box: fill-box; transform-origin: center; transition: transform .9s cubic-bezier(.3, .7, .2, 1), opacity .6s .35s; }
  .escena:not([data-etapa="cerrado"]) .caja { animation: none; cursor: default; }
  .escena:not([data-etapa="cerrado"]) .tapa { transform: translate(34px, -96px) rotate(22deg); opacity: 0; }
  .escena:not([data-etapa="cerrado"]) .mono { transform: translateY(-70px) scale(1.5) rotate(-24deg); opacity: 0; }
  @keyframes flotar { 50% { transform: translateY(-10px) rotate(-1.5deg); } }
  @keyframes pulso { 50% { opacity: .55; } }

  .caja .luz { opacity: 0; transition: opacity .8s .4s; }
  .escena:not([data-etapa="cerrado"]) .luz { opacity: .85; }
  :global([hidden]) { display: none !important; }
  .siguiente { margin-top: 8px; }

  /* Confeti */
  .chispas { position: absolute; inset: 0; pointer-events: none; z-index: 3; }
  .chispas :global(span) { position: absolute; bottom: -40px; animation: subir 4s ease-in forwards; }
  @keyframes subir { to { transform: translate(24px, -110vh) rotate(40deg); opacity: 0; } }

  /* Etapa "para qué te sirve" */
  .ayuda { position: relative; z-index: 2; width: min(960px, 100%); display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .ayuda h1 { font-size: clamp(2rem, 6vw, 3.4rem); }
  .ayuda .bajada { font-size: var(--t-l); margin-bottom: 8px; }
  .beneficios { list-style: none; padding: 0; width: 100%; display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; text-align: left; }
  .beneficios li { display: grid; grid-template-columns: 56px 1fr; gap: 16px; align-items: start; background: var(--crema); border-radius: var(--hoja); padding: 20px 22px; border: 1px solid rgba(74, 37, 48, .12); }
  .beneficios li:nth-child(even) { border-radius: var(--hoja-inv); }
  .beneficios h2 { font-size: var(--t-l); font-weight: 500; }
  .beneficios p { font-size: var(--t-s); margin-top: 4px; line-height: 1.55; }
  .beneficios li, .cierre { animation: aparece .7s cubic-bezier(.2, .8, .2, 1) both; animation-delay: calc(var(--i) * .16s + .1s); }
  .cierre { width: 100%; margin-top: 6px; background: var(--burdeos); color: var(--crema); border-radius: 56px 12px 56px 12px; padding: clamp(24px, 5vw, 44px); --ring: var(--crema); }
  .cierre h2 { font-style: italic; font-weight: 400; font-size: clamp(1.7rem, 4.6vw, 2.7rem); line-height: 1.1; }
  .cierre p { margin: 12px auto 0; max-width: 52ch; font-size: var(--t-m); color: var(--rosa-suave); }
  .ver-pagina { margin-top: 14px; }
  .ayuda h1:focus, .presentacion h1:focus { outline: none; } /* el foco al cambiar de etapa es solo para lectores de pantalla */
  @media (max-width: 700px) { .beneficios { grid-template-columns: 1fr; } }

  /* Presentación de la página */
  .presentacion { position: relative; z-index: 2; width: min(1040px, 100%); display: flex; flex-direction: column; align-items: center; gap: 14px; animation: aparece .9s cubic-bezier(.2, .8, .2, 1) both; }
  .presentacion h1 { font-size: clamp(2rem, 6vw, 3.4rem); }
  .presentacion p { font-size: var(--t-l); max-width: 36ch; }
  .marco { width: 100%; max-width: 1040px; background: var(--blanco); border-radius: 18px; border: 2px solid var(--burdeos); overflow: hidden; box-shadow: 0 18px 0 -6px rgba(74, 37, 48, .18); margin: 10px 0 8px; }
  .barra { display: flex; gap: 7px; padding: 10px 14px; background: var(--burdeos); }
  .barra i { width: 11px; height: 11px; border-radius: 50%; background: var(--rosa); }
  .barra i:nth-child(2) { background: var(--crema); }
  .barra i:nth-child(3) { background: var(--salvia); }
  .marco iframe { display: block; width: 100%; height: clamp(380px, 62dvh, 680px); border: 0; background: var(--crema); }
  @media (max-width: 600px) { .marco { max-width: 380px; } }
  @keyframes aparece { from { opacity: 0; transform: translateY(46px) scale(.95); } }

  .ir-directo { position: absolute; bottom: 16px; left: 50%; translate: -50% 0; z-index: 2; font-size: var(--t-s); font-weight: 500; padding: 12px 16px; text-underline-offset: 4px; }
</style>
</body>
</html>
