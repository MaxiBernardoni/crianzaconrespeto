---
import Base from "../layouts/Base.astro";
import sitio from "../content/sitio.json";
import privacidad from "../content/privacidad.json";

const parrafos = (texto: string) => texto.split(/\n\s*\n/);
---
<Base titulo={`${privacidad.titulo} · ${sitio.nombre}`} descripcion={privacidad.intro} ruta="/privacidad">
<main id="inicio" class="legal">
  <div class="wrap">
    <h1>{privacidad.titulo}</h1>
    <p class="actualizado">Última actualización: {privacidad.actualizado}</p>
    <p class="lead">{privacidad.intro}</p>
    {privacidad.secciones.map((s) => (
      <div>
        <h2>{s.titulo}</h2>
        {parrafos(s.texto).map((p) => <p>{p}</p>)}
      </div>
    ))}
    <p class="volver"><a href="/">Volver al inicio</a></p>
  </div>
</main>
</Base>
